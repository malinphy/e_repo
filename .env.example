# ==========================================
# ShopAgent AI - Environment Variables
# ==========================================

# LLM Providers (Required for Agent Graph)
OPENAI_API_KEY=your_openai_api_key_here

# External Search Provider (SerpAPI for Walmart, eBay, Amazon, Google Shopping)
SERPAPI_API_KEY=your_serpapi_api_key_here

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=ecommerce-agent

# SQLite Database (Default path: backend/data/ecommerce.db)
# SQLITE_DB_PATH=backend/data/ecommerce.db
